#include <windows.h>
#include <commctrl.h>
#include "resource.h"
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDD_MAIN DIALOGEX 0, 0, 420, 264
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
EXSTYLE WS_EX_APPWINDOW | WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_TASK_LABEL, 12, 15, 78, 14
    COMBOBOX IDC_TASK, 94, 12, 312, 90, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "", IDC_INPUT_LABEL, 12, 49, 78, 14
    EDITTEXT IDC_INPUT, 94, 46, 244, 22, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "", IDC_BROWSE_INPUT, 344, 46, 62, 22
    LTEXT "", IDC_OUTPUT_LABEL, 12, 83, 78, 14
    EDITTEXT IDC_OUTPUT, 94, 80, 244, 22, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "", IDC_BROWSE_OUTPUT, 344, 80, 62, 22
    LTEXT "", IDC_STRENGTH_LABEL, 12, 117, 78, 14
    CONTROL "", IDC_STRENGTH, TRACKBAR_CLASS, TBS_AUTOTICKS | WS_TABSTOP, 94, 112, 264, 28
    RTEXT "100", IDC_STRENGTH_VALUE, 366, 117, 40, 14
    CONTROL "", IDC_ASSUME, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 94, 144, 312, 18
    LTEXT "", IDC_LANGUAGE_LABEL, 12, 178, 78, 14
    COMBOBOX IDC_LANGUAGE, 94, 174, 110, 66, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "", IDC_STATUS, 12, 207, 394, 26
    CONTROL "", IDC_PROGRESS, PROGRESS_CLASS, 0, 12, 238, 160, 10
    PUSHBUTTON "", IDC_OPEN, 184, 234, 100, 22
    PUSHBUTTON "", IDC_CANCEL, 290, 234, 54, 22
    DEFPUSHBUTTON "", IDC_RUN, 350, 234, 56, 22
END
