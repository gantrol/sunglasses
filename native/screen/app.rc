#include <windows.h>
#include <commctrl.h>
#include "resource.h"
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDI_SUNGLASSES ICON "assets/Sunglasses.ico"
IDD_SCREEN DIALOGEX 0, 0, 340, 208
STYLE DS_SETFONT | WS_POPUP | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW | WS_EX_CONTROLPARENT
FONT 10, "Segoe UI"
BEGIN
    LTEXT "", IDC_CASE_TITLE, 12, 4, 150, 20
    LTEXT "", IDC_STATE, 12, 30, 240, 40
    CONTROL "", IDC_CASE_CLOSE, "Button", BS_OWNERDRAW | WS_TABSTOP, 265, 4, 63, 20
    CONTROL "", IDC_STOP, "Button", BS_OWNERDRAW | WS_TABSTOP, 12, 74, 156, 20
    CONTROL "", IDC_SWITCH, "Button", BS_OWNERDRAW | WS_TABSTOP, 174, 74, 154, 20
    LTEXT "", IDC_RECORDING_LABEL, 12, 98, 72, 14
    COMBOBOX IDC_RECORDING, 86, 96, 242, 70, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_TABSTOP
    LTEXT "", IDC_SCREEN_LABEL, 12, 15, 72, 14
    COMBOBOX IDC_SCREEN, 86, 12, 242, 85, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_TABSTOP | WS_VSCROLL
    LTEXT "", IDC_MODE_LABEL, 12, 46, 72, 14
    COMBOBOX IDC_MODE, 86, 43, 242, 70, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_TABSTOP
    LTEXT "", IDC_LEVEL_LABEL, 12, 78, 72, 14
    CONTROL "", IDC_LEVEL, TRACKBAR_CLASS, TBS_NOTICKS | TBS_FIXEDLENGTH | WS_TABSTOP, 86, 72, 199, 26
    RTEXT "50", IDC_LEVEL_VALUE, 291, 78, 37, 14
    LTEXT "", IDC_LOCALE_LABEL, 12, 108, 72, 14
    COMBOBOX IDC_LOCALE, 86, 104, 122, 68, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_TABSTOP
END
